<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tixly Dashboard - Overview</title>
  <style>
    body { font-family: Arial, sans-serif; background-color: #1e1e2e; color: #fff; padding: 40px; }
    .card { background: #2b2b3d; padding: 25px; border-radius: 10px; max-width: 600px; margin: 0 auto; }
    .user-info { display: flex; align-items: center; gap: 15px; margin-bottom: 20px; }
    .avatar { border-radius: 50%; width: 60px; height: 60px; }
    .btn-logout { background-color: #ed4245; color: white; padding: 8px 16px; text-decoration: none; border-radius: 5px; font-size: 14px; }
  </style>
</head>
<body>
  <div class="card">
    <div class="user-info">
      <% if (user.avatar) { %>
        <img class="avatar" src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png" alt="Avatar">
      <% } %>
      <div>
        <h2>Welcome, <%= user.username %>!</h2>
        <p>You have successfully logged in to the Tixly Dashboard.</p>
      </div>
    </div>
    <hr style="border-color: #3f3f5a; margin: 20px 0;">
    <h3>Your Servers</h3>
    <p>Total servers found: <strong><%= user.guilds ? user.guilds.length : 0 %></strong></p>
    <br>
    <a href="/" class="btn-logout">Log Out</a>
  </div>
</body>
</html>